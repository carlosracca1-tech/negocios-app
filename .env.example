# Database
DATABASE_URL="postgresql://user:password@localhost:5432/negocios_db"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API (for receipt OCR with Claude Vision)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Demo credentials (ONLY for development/staging - NEVER set in production)
# Set NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true ONLY in dev environments
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=false
NEXT_PUBLIC_DEMO_EMAIL=""
NEXT_PUBLIC_DEMO_PASS=""

# ── Envío de mails (Resend) ──────────────────────────────────────────
# Necesario para recuperar contraseña y verificar el email.
# La API key se saca de https://resend.com/api-keys
# Sin RESEND_API_KEY la app no se rompe: escribe el mail en la consola
# del servidor, así se puede probar el flujo en desarrollo.
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# EMAIL_FROM="N$ <no-reply@tudominio.com>"
